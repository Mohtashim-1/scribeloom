{
  "name": "@openedit/collab-server",
  "version": "0.0.0",
  "private": true,
  "description": "Reference collaboration server for OpenEdit: Hocuspocus with pluggable persistence and an auth hook.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --onSuccess \"node dist/main.js\"",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hocuspocus/extension-database": "3.4.4",
    "@hocuspocus/server": "3.4.4",
    "better-sqlite3": "^12.11.1",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@hocuspocus/provider": "3.4.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  },
  "optionalDependencies": {
    "pg": "^8.23.1"
  }
}
