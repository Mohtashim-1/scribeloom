{
  "name": "@openedit/core",
  "version": "0.0.0",
  "description": "Framework-agnostic editor core for OpenEdit: createEditor() and defineExtension() over the TipTap engine.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-highlight": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-text-align": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
