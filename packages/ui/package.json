{
  "name": "@openedit/ui",
  "version": "0.0.0",
  "description": "The default OpenEdit UI: toolbar, bubble menu, slash menu, link editor, table and image controls.",
  "keywords": [
    "rich-text-editor",
    "wysiwyg",
    "editor",
    "prosemirror",
    "tiptap",
    "collaboration",
    "react"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Mohtashim-1/scribeloom#readme",
  "bugs": "https://github.com/Mohtashim-1/scribeloom/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mohtashim-1/scribeloom.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && pnpm build:css",
    "build:css": "tailwindcss -i src/styles.css -o dist/styles.css --minify",
    "dev": "pnpm run \"/^dev:.*/\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev:js": "tsup --watch",
    "dev:css": "tailwindcss -i src/styles.css -o dist/styles.css --watch"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.9",
    "@openedit/ai": "workspace:*",
    "@openedit/core": "workspace:*",
    "@openedit/extensions": "workspace:*",
    "@openedit/react": "workspace:*",
    "lucide-react": "^1.55.0",
    "radix-ui": "^1.7.0"
  },
  "devDependencies": {
    "@openedit/themes": "workspace:*",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
